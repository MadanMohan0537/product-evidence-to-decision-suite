{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fraudshield",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/predict", "/health"]
  },
  "observability": {
    "enabled": true
  }
}
