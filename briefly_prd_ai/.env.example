# Server-only DeepSeek key used for public PRD generation.
DEEPSEEK_API_KEY=
# Optional. Defaults to DeepSeek's fast, cost-efficient V4 model.
DEEPSEEK_MODEL=deepseek-v4-flash

# Copy these REST credentials from the Upstash database console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a long random value. Changing it resets how visitor IPs are grouped.
RATE_LIMIT_SALT=
